{
  "manifest_version": 3,
  "name": "Copiloto WhatsApp MD Marketing",
  "description": "Painel assistido da IA SDR para WhatsApp Web.",
  "version": "0.1.1",
  "content_scripts": [
    {
      "css": ["styles.css"],
      "js": ["content.js"],
      "matches": ["https://web.whatsapp.com/*"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://ia-sdr-md-marketing.vercel.app/*"
  ],
  "permissions": ["storage"]
}
